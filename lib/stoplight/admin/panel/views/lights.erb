<% if lights.empty? %>
  <%= erb :_empty %>
<% else %>
  <ul data-role="light-list" class="bg-white border-b border-gray-200">
    <% lights.each do |light| %>
      <li data-role="light-row" data-light="<%= CGI.escapeHTML(light.name) %>" class="px-4 py-3 border-b border-gray-200 text-sm">
        <%= CGI.escapeHTML(light.name) %>
      </li>
    <% end %>
  </ul>
<% end %>
