<% if lights.empty? %>
  <%= erb :_empty %>
<% else %>
  <turbo-frame id="light-detail" class="light-frame">
    <div class="light-card grid bg-white border border-gray-200 h-full">
      <div class="light-pane bg-gray-50 border-r border-gray-200 overflow-y-auto">
        <ul data-role="light-list">
          <% lights.each do |light| %>
            <li data-role="light-row" data-light="<%= CGI.escapeHTML(light.name) %>" data-color="<%= light.color %>" data-locked="<%= light.locked? %>">
              <a
                href="<%= system_url(current_system_id, "/lights/#{CGI.escapeHTML(light.id)}") %>"
                data-turbo-action="advance"
                <% if light.id == selected_light.id %>aria-current="page"<% end %>
                class="light-row flex items-center gap-2 text-sm border-b border-gray-100"
              >
                <span class="w-2 h-2 rounded-full shrink-0 bg-<%= light.color %>-600"></span>
                <span class="light-row-name flex-1 min-w-0 truncate"><%= CGI.escapeHTML(light.name) %></span>
                <% if light.locked? %>
                  <svg data-role="lock-icon" role="img" aria-label="Locked" class="w-3 h-3 shrink-0 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="16" r="1"/><rect x="3" y="10" width="18" height="12" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/>
                  </svg>
                <% end %>
              </a>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="light-pane light-detail-pane overflow-y-auto">
        <%= erb :_light_detail, locals: {light: selected_light} %>
      </div>
    </div>
  </turbo-frame>
<% end %>
