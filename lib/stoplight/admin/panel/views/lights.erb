<% if lights.empty? %>
  <%= erb :_empty %>
<% else %>
  <ul data-role="light-list" class="bg-white border-b border-gray-200">
    <% lights.each do |light| %>
      <li data-role="light-row" data-light="<%= CGI.escapeHTML(light.name) %>" data-color="<%= light.color %>" class="px-4 py-3 border-b border-gray-200 text-sm flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full shrink-0 bg-<%= light.color %>-500"></span>
        <%= CGI.escapeHTML(light.name) %>
      </li>
    <% end %>
  </ul>
<% end %>
