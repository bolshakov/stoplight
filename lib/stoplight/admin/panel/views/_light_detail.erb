<div data-role="light-detail" data-light="<%= CGI.escapeHTML(light.name) %>">
  <div class="light-detail-grid grid">
    <div class="light-detail-avatar relative w-10 h-10">
      <div class="inline-flex items-center justify-center w-10 h-10 rounded-full text-sm font-medium bg-<%= light.color %>-100 text-<%= light.color %>-600">
        <%= CGI.escapeHTML(light.name[0].to_s.upcase) %>
      </div>
      <div class="absolute bottom-0 right-0 inline-flex items-center justify-center w-4 h-4 bg-white border-2 border-white rounded-full">
        <% if light.locked? %>
          <svg aria-hidden="true" class="w-3 h-3 text-<%= light.color %>-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="16" r="1"/><rect x="3" y="10" width="18" height="12" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/>
          </svg>
        <% else %>
          <svg aria-hidden="true" class="w-3 h-3 text-<%= light.color %>-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="16" r="1"/><rect x="3" y="10" width="18" height="12" rx="2"/><path d="M7 10V7a5 5 0 0 1 9.33-2.5"/>
          </svg>
        <% end %>
      </div>
    </div>

    <h2 class="light-detail-name min-w-0 truncate text-xl font-semibold"><%= CGI.escapeHTML(light.name) %></h2>

    <%= erb state_template_for(light), locals: {light: light} %>
  </div>
</div>
