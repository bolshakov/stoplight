module Stoplight
  module Wiring
    class LightFactory
      include Domain::_LightFactory
      attr_reader settings: Settings

      def initialize: (settings: Settings) -> void

      def validate_configuration!: -> void

      def eql: (untyped other) -> bool
      def hash: -> Integer

      def light_builder: (config: Domain::Config) -> LightBuilder
      def light_factory: -> Domain::_LightFactory
    end
  end
end
