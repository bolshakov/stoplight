module Stoplight
  module Wiring
    class System
      include _System

      @name: String

      attr_reader light_factory: Domain::_LightFactory
      attr_reader lights: Concurrent::Map[String, [_Light, Settings]]
      attr_reader settings: Settings

      def initialize: (String name, settings: Settings) -> void

      def validate_configuration!: -> void
    end
  end
end
