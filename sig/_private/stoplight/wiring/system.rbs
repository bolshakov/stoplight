module Stoplight
  module Wiring
    class System
      include _System

      @name: String
      @failover_system: System?

      attr_reader lights: Concurrent::Map[String, [_Light, Integer, String?]]
      attr_reader system_config: Domain::Config

      def initialize: (config: Domain::Config) -> void

      private def failover_system: -> System
    end
  end
end
