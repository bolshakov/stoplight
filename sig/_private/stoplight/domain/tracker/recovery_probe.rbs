module Stoplight
  module Domain
    module Tracker
      class RecoveryProbe < Base
        attr_reader traffic_recovery: TrafficRecovery::Base
        attr_reader notifiers: Array[state_transition_notifier]
        attr_reader config: Domain::Config
        attr_reader metrics_store: Storage::Metrics
        attr_reader state_store: Storage::State

        def initialize: (
          config: Domain::Config,
          traffic_recovery: TrafficRecovery::Base,
          notifiers: Array[state_transition_notifier],
          metrics_store: Storage::Metrics,
          state_store: Storage::State,
        ) -> void

        def record_failure: (StandardError exception) -> void
        def record_success: -> void
        def recover: -> void
      end
    end
  end
end
