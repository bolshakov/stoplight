module Stoplight
  module Domain
    class Config < Data
      attr_reader threshold: threshold
      attr_reader window_size: window_size
      attr_reader tracked_errors: errors
      attr_reader skipped_errors: errors
      attr_reader name: String
      attr_reader cool_off_time: cool_off_time
      attr_reader recovery_threshold: recovery_threshold
      attr_reader traffic_control: TrafficControl::Base
      attr_reader traffic_recovery: TrafficRecovery::Base
      attr_reader error_notifier: error_notifier
      attr_reader notifiers: notifiers
      attr_reader data_store: data_store

      def self.new: (
          name: String,
          cool_off_time: cool_off_time,
          threshold: threshold,
          recovery_threshold: recovery_threshold,
          window_size: window_size,
          tracked_errors: errors,
          skipped_errors: errors,
          traffic_control: TrafficControl::Base,
          traffic_recovery: TrafficRecovery::Base,
          error_notifier: error_notifier,
          notifiers: notifiers,
          data_store: data_store
        ) -> instance

      def initialize: (
          name: String,
          cool_off_time: cool_off_time,
          threshold: threshold,
          recovery_threshold: recovery_threshold,
          window_size: window_size,
          tracked_errors: errors,
          skipped_errors: errors,
          traffic_control: TrafficControl::Base,
          traffic_recovery: TrafficRecovery::Base,
          error_notifier: error_notifier,
          notifiers: notifiers,
          data_store: data_store
        ) -> void

      def track_error?: ((Class)  error) -> bool

      def cool_off_time_in_milliseconds: () -> Integer

      def with: (
          ?name: String,
          ?cool_off_time: cool_off_time,
          ?threshold: threshold,
          ?recovery_threshold: recovery_threshold,
          ?window_size: window_size,
          ?tracked_errors: errors,
          ?skipped_errors: errors,
          ?traffic_control: TrafficControl::Base,
          ?traffic_recovery: TrafficRecovery::Base,
          ?error_notifier: error_notifier,
          ?notifiers: notifiers,
          ?data_store: data_store
      ) -> Config
    end
  end
end
