# frozen_string_literal: true

module Stoplight
  module Domain
    class System
      attr_reader name: String

      def light: (
        String name,
        ?cool_off_time: cool_off_time | undefined,
        ?threshold: threshold | undefined,
        ?recovery_threshold: recovery_threshold | undefined,
        ?window_size: window_size | undefined,
        ?skipped_errors: errors | undefined,
        ?tracked_errors: errors | undefined,
        ?traffic_control: traffic_control | undefined,
        ?traffic_recovery: traffic_recovery | undefined
      ) -> Light
    end
  end
end
