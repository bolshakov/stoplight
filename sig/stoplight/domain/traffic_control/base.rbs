module Stoplight
  module Domain
    module TrafficControl
      class Base
        def check_compatibility: (Config config) -> CompatibilityResult

        def stop_traffic?: (Config config, Domain::MetricsSnapshot metrics) -> bool
        def ==: (untyped) -> bool

        private def compatible: -> CompatibilityResult
        private def incompatible: (*String)-> CompatibilityResult
      end
    end
  end
end
