module Stoplight
  class Admin
    class Panel
      class LightSummary < Data
        attr_reader id: String
        attr_reader name: String
        attr_reader color: Domain::color
        attr_reader lock_state: Domain::state

        def self.new: (
            id: String,
            name: String,
            color: Domain::color,
            lock_state: Domain::state,
          ) -> instance

        def initialize: (
            id: String,
            name: String,
            color: Domain::color,
            lock_state: Domain::state,
          ) -> void

        def locked?: -> bool
      end
    end
  end
end
