module Stoplight
  module Wiring
    class System
      class LightBuilder < Wiring::LightBuilder
        @system: System
        @failover_system: System

        def initialize: (System, settings) -> void

        def key_space: -> Infrastructure::Redis::Storage::KeySpace

        private def redis: -> Domain::DataStoreConfig
        private def storage_scripting: -> Infrastructure::Redis::Storage::Scripting
        private def failover_system: -> System
      end
    end
  end
end
