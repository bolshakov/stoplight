module Stoplight
  module Infrastructure
    module FailSafe
      module Storage
        class RecoveryLock < Domain::Storage::RecoveryLock[Domain::RecoveryLockToken]
          attr_reader primary_store: Domain::Storage::RecoveryLock[Domain::RecoveryLockToken]
          attr_reader error_notifier: error_notifier
          attr_reader failover_store: Domain::Storage::RecoveryLock[Domain::RecoveryLockToken]
          attr_reader circuit_breaker: Domain::Light

          def initialize: (
            primary_store: Domain::Storage::RecoveryLock[Domain::RecoveryLockToken],
            error_notifier: error_notifier,
            failover_store: Domain::Storage::RecoveryLock[Domain::RecoveryLockToken],
            circuit_breaker: Domain::Light
          ) -> void
        end
      end
    end
  end
end
